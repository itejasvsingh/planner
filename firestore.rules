rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserPhone() {
      return getUserData().phone;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && (
        ownerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && ownerId == getUserPhone())
      );
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Planner items: tasks, expenses, and income records
    match /planner_items/{itemId} {
      allow read: if isAuthenticated() ? isOwner(resource.data.ownerId) : true;
      allow create: if isAuthenticated() ? isOwner(request.resource.data.ownerId) : (request.resource.data.ownerId is string && request.resource.data.ownerId.size() > 0);
      allow update, delete: if isAuthenticated() ? isOwner(resource.data.ownerId) : true;
    }

    // User settings: preferences and budgets
    match /planner_settings/{settingId} {
      allow read, write: if isAuthenticated() ? (
        settingId == ('preferences_' + request.auth.uid) ||
        settingId == ('budgets_' + request.auth.uid) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          settingId == ('preferences_' + getUserPhone()) ||
          settingId == ('budgets_' + getUserPhone())
        ))
      ) : true;
    }

    // rate_limits: server-side only (managed via Admin SDK)
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // user_sessions: server-side only (managed via Admin SDK)
    match /user_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

