rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed-in users own documents keyed by their uid or by any spelling of their verified WhatsApp number.
    // The number reaches the token only through the server's WhatsApp code check (lib/phoneAuth.ts), as the
    // `phones` custom claim. The server (Admin SDK) is not subject to these rules.
    function isOwner(ownerId) {
      return request.auth != null && (
        ownerId == request.auth.uid ||
        ('phones' in request.auth.token && ownerId in request.auth.token.phones)
      );
    }

    // Profile. The phone field is written by the server after verification, never by the app.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && !('phone' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone', 'phoneVerifiedAt']);
    }

    // Tasks, expenses, income, goals.
    match /planner_items/{itemId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && isOwner(request.resource.data.ownerId);
    }

    match /planner_settings/{settingId} {
      // preferences_<owner>, budgets_<owner>
      allow read, write: if settingId.matches('^(preferences|budgets)_[^_]+$') && isOwner(settingId.split('_')[1]);
      // SMS/email import keys: ingest_<sha256(key)>, data.phone is the owner. Only the server reads them.
      allow create, update: if settingId.matches('^ingest_[0-9a-f]{64}$') && isOwner(request.resource.data.phone);
      allow delete: if settingId.matches('^ingest_[0-9a-f]{64}$') && isOwner(resource.data.phone);
    }

    // WhatsApp bot memory and the app's reminder/summary settings, keyed by phone.
    match /user_sessions/{sessionId} {
      allow read, write: if isOwner(sessionId);
    }

    // Everything else (rate_limits, auth_codes, Gmail links) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
