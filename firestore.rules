rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // No auth system yet — lock writes, allow reads
    // TEMPORARY RULES: tighten further once Firebase Auth is added
    
    match /planner_items/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /planner_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Block everything not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
