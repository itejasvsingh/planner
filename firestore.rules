rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: lookup phone number from users/{uid} mapping doc
    function currentUserPhone() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone;
    }

    // 1. User profile and uid -> phone mapping
    // Users can only read and write their own mapping
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 2. Planner Items (tasks, expenses, goals)
    match /planner_items/{docId} {
      allow read: if request.auth != null && resource.data.ownerId == currentUserPhone();
      allow create: if request.auth != null && request.resource.data.ownerId == currentUserPhone();
      allow update, delete: if request.auth != null && resource.data.ownerId == currentUserPhone();
    }

    // 3. Planner Settings (preferences & budgets)
    match /planner_settings/{docId} {
      allow read, write: if request.auth != null && (
        docId == ('preferences_' + currentUserPhone()) ||
        docId == ('budgets_' + currentUserPhone())
      );
    }

    // 4. Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
