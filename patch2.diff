+/* Explicit in-app theme choice (set via JS on <html data-theme="...">) always wins
+   over the OS-level prefers-color-scheme guess above, so toggling dark mode inside
+   the app doesn't leave the page background stuck on the OS setting. */
+html[data-theme="dark"],
+html[data-theme="dark"] body,
+html[data-theme="dark"] #root {
+  background-color: #0A0B0F !important;
+  color: #F5F5F7 !important;
+}
+
+html[data-theme="light"],
+html[data-theme="light"] body,
+html[data-theme="light"] #root {
+  background-color: #F4F7F6 !important;
+  color: #182B32 !important;
+}
