{
  "expo": {
    "name": "Align",
    "slug": "align-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "align",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Align to securely recognize your speech.",
        "NSMicrophoneUsageDescription": "Allow Align to access your microphone for voice transcription."
      },
      "bundleIdentifier": "com.tejasvsingh.align"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.tejasvsingh.align"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Align to securely authenticate you with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#007AFF"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Align to access your microphone for voice transcription.",
          "speechRecognitionPermission": "Allow Align to securely recognize your speech."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyDSIN2F2sDc-vB_S7ITCMnKILbr9l-r6co",
        "authDomain": "planner-app-3471f.firebaseapp.com",
        "projectId": "planner-app-3471f",
        "storageBucket": "planner-app-3471f.firebasestorage.app",
        "messagingSenderId": "817744322906",
        "appId": "1:817744322906:web:35d264cd7079a211749363"
      },
      "router": {},
      "eas": {
        "projectId": "3bbcf086-82d6-41f6-a682-d439a890514d"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "itejasv"
  }
}
